# 本地默认 SQLite；Compose 使用独立 PostgreSQL 服务
PROFITOPS_DATABASE_URL=sqlite:///./data/profitops.db
PROFITOPS_DEMO_MODE=true
PROFITOPS_AUTO_SEED=true
PROFITOPS_STEP_TIMEOUT_SECONDS=15
# 仅本机演示身份，公开值，不是生产凭证
PROFITOPS_ANALYST_TOKEN=demo-analyst
PROFITOPS_APPROVER_TOKEN=demo-approver
# 仅 SQLite 本地初始化时使用，不需要 LLM Key
