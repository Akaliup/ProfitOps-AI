# 本地默认 SQLite；Compose 使用独立 PostgreSQL 服务
PROFITOPS_DATABASE_URL=sqlite:///./data/profitops.db
PROFITOPS_DEMO_MODE=true
PROFITOPS_AUTO_SEED=true
PROFITOPS_STEP_TIMEOUT_SECONDS=15
# 仅本机演示身份，公开值，不是生产凭证
PROFITOPS_ANALYST_TOKEN=demo-analyst
PROFITOPS_APPROVER_TOKEN=demo-approver

# DeepSeek LLM（可选）。不填写 LLM_API_KEY 时继续使用确定性规则引擎。
# 真实 Key 只放在本地 .env 或进程环境变量中，绝不提交到 Git。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=20
LLM_MAX_TOKENS=4000
LLM_MAX_RETRIES=1
# rules = 调用失败时降级到确定性规则；fail = 分析直接失败
LLM_FALLBACK_POLICY=rules
# 原生 Function Calling：模型只可调用服务端允许的只读工具
LLM_NATIVE_TOOLS=true
LLM_TOOL_MAX_ROUNDS=4
LLM_TOOL_MAX_CALLS=6
LLM_TOOL_MAX_REPEATS=2
LLM_TOOL_BUDGET_SECONDS=90
LLM_TOOL_RESULT_MAX_BYTES=16384
