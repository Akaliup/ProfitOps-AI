# 本地默认 SQLite；Compose 使用独立 PostgreSQL 服务
PROFITOPS_DATABASE_URL=sqlite:///./data/profitops.db
PROFITOPS_DEMO_MODE=true
PROFITOPS_AUTO_SEED=true
PROFITOPS_STEP_TIMEOUT_SECONDS=15
# 仅本机演示身份，公开值，不是生产凭证
PROFITOPS_ANALYST_TOKEN=demo-analyst
PROFITOPS_APPROVER_TOKEN=demo-approver
# 演示登录账号（邮箱 + 密码），首次启动写入 users 表；密码只用于本地演示
PROFITOPS_DEMO_ANALYST_PASSWORD=demo-analyst
PROFITOPS_DEMO_APPROVER_PASSWORD=demo-approver
# JWT 签名密钥：非 demo mode 必须改成至少 16 字符的随机值
PROFITOPS_AUTH_SECRET=dev-only-change-me
PROFITOPS_AUTH_ISSUER=profitops
PROFITOPS_AUTH_TOKEN_TTL_SECONDS=3600
# 只读 MCP stdio Server 的服务端角色：analyst 或 approver
PROFITOPS_MCP_ROLE=analyst

# 持久化分析任务队列
PROFITOPS_ANALYSIS_WORKER_ENABLED=true
PROFITOPS_ANALYSIS_WORKER_POLL_SECONDS=1
PROFITOPS_ANALYSIS_MAX_ATTEMPTS=3
PROFITOPS_ANALYSIS_RETRY_BACKOFF_SECONDS=2
PROFITOPS_ANALYSIS_LEASE_SECONDS=60

# 进程内可观测性与保护。限流桶不跨进程共享，多副本部署需换成共享存储。
PROFITOPS_METRICS_ENABLED=true
PROFITOPS_RATE_LIMIT_ENABLED=true
PROFITOPS_RATE_LIMIT_REQUESTS=120
PROFITOPS_RATE_LIMIT_WINDOW_SECONDS=60
PROFITOPS_RATE_LIMIT_LOGIN_REQUESTS=10
PROFITOPS_RATE_LIMIT_ANALYSIS_REQUESTS=30
PROFITOPS_CIRCUIT_BREAKER_ENABLED=true
PROFITOPS_CIRCUIT_BREAKER_FAILURES=3
PROFITOPS_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# DeepSeek LLM（可选）。不填写 LLM_API_KEY 时继续使用确定性规则引擎。
# 真实 Key 只放在本地 .env 或进程环境变量中，绝不提交到 Git。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=20
LLM_MAX_TOKENS=4000
LLM_MAX_RETRIES=1
# rules = 调用失败时降级到确定性规则；fail = 分析直接失败
LLM_FALLBACK_POLICY=rules
# 原生 Function Calling：模型只可调用服务端允许的只读工具
LLM_NATIVE_TOOLS=true
LLM_TOOL_MAX_ROUNDS=4
LLM_TOOL_MAX_CALLS=6
LLM_TOOL_MAX_REPEATS=2
LLM_TOOL_BUDGET_SECONDS=90
LLM_TOOL_RESULT_MAX_BYTES=16384
